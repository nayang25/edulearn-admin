{
  "name": "edulearn-admin-fullstack",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "node --env-file=server/.env --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=server/.env server/index.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "firebase-admin": "14.5.0",
    "firebase": "13.0.0",
    "helmet": "8.3.0",
    "express-rate-limit": "^8.1.0",
    "zod": "^4.1.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "overrides": { "@grpc/grpc-js": "1.13.6" }
}
